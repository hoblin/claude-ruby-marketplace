#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler"
require "fileutils"
require "rdoc"

USAGE = <<~TEXT
  Usage: gem-docs sync

  Run in a project root. Renders the ri documentation of every gem in Gemfile.lock as
  markdown, one file per class, and links this project's versions into thoughts/gem-docs.
TEXT

CACHE = File.join(ENV.fetch("XDG_CACHE_HOME", File.expand_path("~/.cache")), "gem-docs")
VIEW = File.join("thoughts", "gem-docs")

def ri_dir(spec)
  dir = spec.doc_dir("ri")
  system("gem", "rdoc", spec.name, "--version", spec.version.to_s, "--ri", "--no-rdoc", "--quiet", exception: true) unless Dir.exist?(dir)
  dir
end

def render(spec, target)
  store = RDoc::RI::Store.new(RDoc::Options.new, path: ri_dir(spec), type: :gem)
  store.load_cache
  driver = RDoc::RI::Driver.new(use_system: false, use_site: false, use_home: false, use_gems: false, show_all: true)
  driver.stores = [store]
  building = "#{target}.#{Process.pid}"
  store.module_names.each do |name|
    file = File.join(building, "#{name.split("::").join("/")}.md")
    FileUtils.mkdir_p(File.dirname(file))
    document = driver.class_document(name, *driver.classes_and_includes_and_extends_for(name))
    File.write(file, document.accept(RDoc::Markup::ToMarkdown.new))
  end
  FileUtils.mkdir_p(building)
  File.rename(building, target)
end

abort USAGE unless ARGV == ["sync"]
abort "gem-docs: no thoughts/ here; run it in a project root" unless Dir.exist?("thoughts")

installed = Gem::Specification.to_h { [it.full_name, it] }
locked = Bundler.definition.specs

FileUtils.mkdir_p(VIEW)
Dir.children(VIEW).each { File.delete(File.join(VIEW, it)) }

missing = locked.filter_map do |lock|
  spec = installed[lock.full_name] or next lock.full_name
  target = File.join(CACHE, spec.full_name)
  render(spec, target) unless Dir.exist?(target)
  File.symlink(target, File.join(VIEW, spec.full_name))
  nil
end

puts "gem-docs: #{locked.size - missing.size} gems in #{VIEW}"
puts "not installed as gems: #{missing.join(", ")}" if missing.any?
