#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "$(realpath "$0")")/../lib/thoughts.sh"

usage() {
  cat <<'TEXT'
thoughts-sync — commit, pull and push a thoughts repository

Usage: thoughts-sync [directory] [-m "message"]

  directory: any path inside the thoughts repository to sync, a note included
             (default: ~/thoughts)
TEXT
}

THOUGHTS_DIR="$(thoughts_repo)"
MESSAGE=""

while [[ $# -gt 0 ]]; do
  case $1 in
    -h|--help)
      usage
      exit 0
      ;;
    -m|--message)
      MESSAGE="$2"
      shift 2
      ;;
    -*)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
    *)
      THOUGHTS_DIR="$(thoughts_repo "$1")"
      shift
      ;;
  esac
done

if [[ ! -d "$THOUGHTS_DIR/.git" ]]; then
  echo "Error: $THOUGHTS_DIR is not a git repository" >&2
  exit 1
fi

cd "$THOUGHTS_DIR"

git add -A

if git diff --cached --quiet && git diff --quiet; then
  echo "Nothing to commit."
else
  COUNT=$(git diff --cached --name-only | grep -c .)
  git commit --quiet -m "${MESSAGE:-Sync thoughts - $(date -Iseconds)}"
  echo "✅ Committed ${COUNT} changed file(s)."
fi

if ! git pull --rebase --quiet; then
  if git status | grep -q "rebase in progress"; then
    echo "Error: Merge conflict detected in thoughts repository" >&2
    echo "Please resolve conflicts manually in: $THOUGHTS_DIR" >&2
    echo 'Then run "git rebase --continue" and "thoughts-sync" again' >&2
    exit 1
  fi
fi

if git remote get-url origin &>/dev/null; then
  if git push --quiet; then
    echo "✅ In sync with the remote."
  else
    echo "⚠️  Could not push to remote. You may need to push manually."
  fi
else
  echo "ℹ️  No remote configured for thoughts repository"
fi
