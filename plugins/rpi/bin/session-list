#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../lib/sessions"

USAGE = <<~TEXT
  Usage: session-list [project]

  Lists the Claude Code sessions running in tmux windows, or only in tmux session
  <project>: how long each has been working or idle, its model, its context size,
  what it was last asked and its latest step. Changes nothing.
TEXT

abort USAGE if ARGV.size > 1 || %w[-h --help].include?(ARGV.first)

agents = Sessions::Agent.all.to_h { [it.pane, it] }
seats = Sessions.panes.filter_map { |pane| [pane, agents[pane.address]] if agents[pane.address] && (ARGV.empty? || pane.target.project == ARGV.first) }

if seats.empty?
  puts "No Claude Code session runs in #{ARGV.empty? ? "any tmux window" : "tmux session #{ARGV.first}"}."
  puts "Start one with session-start <project>:<clone> <dir>."
  exit
end

now = Time.now
seats.each do |pane, agent|
  transcript = Sessions::Transcript.new(agent)
  since = (agent.idle? || agent.asking?) ? transcript.last_at : transcript.run_started_at
  state = since ? "#{agent.state} for #{Sessions.duration(now - since)}" : agent.state
  context = transcript.context&.then { "#{(it / 1000.0).round}k tokens" }

  puts "#{pane.target} — #{state}, session #{agent.session_id}"
  puts "  model #{transcript.model || "unknown"}, context #{context || "unknown"}"
  puts "  last asked: #{Sessions.preview(transcript.last_ask || "nothing yet")}"
  puts "  latest step: #{Sessions.preview(transcript.latest_step || "none yet")}"
end
puts
puts "Nothing was changed. Read one in full with session-peek <project>:<clone>."
