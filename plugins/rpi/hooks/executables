#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "open3"

bin = File.expand_path("../bin", __dir__)
tools = Dir[File.join(bin, "*")].select { |path| File.file?(path) && File.executable?(path) }.sort

help = lambda do |tool|
  Thread.new do
    Open3.capture3(tool, "--help").first.lines.first&.strip || "#{File.basename(tool)} — its --help printed nothing"
  rescue Errno::ENOENT
  end
end

bullets = ->(lines) { lines.map { |line| "- #{line}" }.join("\n") }

rpi = tools.map(&help)
yard_md = %w[yard-md mdri].map(&help).map(&:value)

gem_docs =
  if yard_md.all?
    "rpi reads gem documentation with the yard-md gem's executables, on the PATH:\n\n#{bullets.call(yard_md)}"
  else
    "rpi reads gem documentation with the yard-md gem, which isn't installed: `mise use -g gem:yard-md` installs it for every project."
  end

puts JSON.generate(
  hookSpecificOutput: {
    hookEventName: "SessionStart",
    additionalContext: <<~TEXT
      The rpi plugin's executables live in #{bin}:

      #{bullets.call(rpi.map(&:value))}

      #{gem_docs}

      Each one's --help prints its usage.
    TEXT
  }
)
